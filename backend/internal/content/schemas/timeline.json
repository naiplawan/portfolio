{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "work",
              "education",
              "achievement",
              "project"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "commit": {
            "type": "object",
            "properties": {
              "hash": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "world": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "hash",
              "message",
              "world"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "organization",
          "location",
          "date",
          "endDate",
          "description",
          "highlights",
          "technologies",
          "commit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "suitableFor": {
            "type": "string",
            "minLength": 1
          },
          "deliverable": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exampleName": {
            "type": "string",
            "minLength": 1
          },
          "exampleHref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "suitableFor",
          "deliverable",
          "features",
          "exampleName",
          "exampleHref"
        ],
        "additionalProperties": false
      }
    },
    "process": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "offers",
    "process"
  ],
  "additionalProperties": false
}
